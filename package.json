{
  "name": "autoshop-takumi",
  "version": "1.0.0",
  "description": "Bilingual JP/EN vehicle sales website for Autoshop Takumi",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:types": "payload generate:types",
    "seed": "tsx scripts/seed.ts",
    "seed:e2e": "tsx scripts/seed-e2e-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "rimraf allure-results",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "pretest:e2e:visual": "rimraf allure-results",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts --project=visual",
    "allure:report": "rimraf allure-report && allure generate allure-results --output allure-report"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.85.1",
    "@payloadcms/db-sqlite": "^3.85.1",
    "@payloadcms/next": "^3.85.1",
    "@payloadcms/richtext-lexical": "^3.85.1",
    "@payloadcms/storage-s3": "^3.85.1",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "0.31.7",
    "graphql": "^17.0.1",
    "lucide-react": "^1.22.0",
    "next": "^15.5.19",
    "next-intl": "^4.13.0",
    "payload": "^3.85.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.16.0",
    "sharp": "^0.35.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.9",
    "allure": "^3.16.0",
    "allure-playwright": "^3.11.0",
    "happy-dom": "^20.10.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wait-on": "^9.1.0"
  },
  "volta": {
    "node": "22.23.2"
  }
}
