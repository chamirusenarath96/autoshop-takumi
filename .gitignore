# dependencies
node_modules/

# Next.js
.next/
out/

# Payload
.payload/

# SQLite (local dev database)
*.db
*.db-shm
*.db-wal

# env files — never commit real secrets
.env
.env.local
.env.production

# media uploads (local dev)
public/media/

# Playwright
playwright-report/
test-results/
e2e/.auth/

# misc
.DS_Store
*.log

# Local editor/tool config — personal, not shared.
# .claude/skills, .claude/commands etc. (e.g. spec-kit's /speckit-* skills)
# ARE shared/committed — only these specific per-developer files are ignored.
.claude/settings.local.json
.claude/launch.json
